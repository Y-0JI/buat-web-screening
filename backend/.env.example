AI_API_KEY=your_ai_api_key_here
AI_MODEL=coba9router
AI_BASE_URL=http://localhost:20128/v1
DATABASE_URL=sqlite+aiosqlite:///./bsjp.db
YFINANCE_PERIOD=6mo
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=15
SCHEDULER_ENABLED=true
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@bsjp.local

# IDX Edge PRO (stock.arjum.com) — sumber data utama.
# Kosongkan IDX_EDGE_API_KEY untuk memakai provider lama (kill-switch).
IDX_EDGE_API_KEY=
IDX_EDGE_BASE_URL=https://stock.arjum.com
IDX_EDGE_TIMEOUT=20
IDX_EDGE_DAILY_QUOTA=1000

# WARNING: Ganti JWT_SECRET sebelum dipakai di production!
